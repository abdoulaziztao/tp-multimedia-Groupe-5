# Envoi direct des enregistrements depuis le site (voir docs/AUDIO.md)

# Ajouté automatiquement par Vercel quand tu connectes un stockage « Blob » au projet.
BLOB_READ_WRITE_TOKEN=

# Mot de passe de la page /moderation (long et unique). Obligatoire en production.
ADMIN_TOKEN=

# moderated (défaut) : les envois attendent ta validation. open : publiés tout de suite.
RECORDINGS_MODE=moderated
